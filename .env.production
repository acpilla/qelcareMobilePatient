# ============================================================================
# QELCare Patient mobile — PRODUCTION build env  (.env.production)
# ----------------------------------------------------------------------------
# This file IS committed on purpose. `.env` and `.env.local` are gitignored, so
# a CI build (GitHub Actions) would otherwise have NO backend URL and Vite would
# inline an empty string -> the installed app could not reach the API.
#
# `vite build` runs in production mode and loads this file, so both the iOS IPA
# (GitHub Actions) and any local `npm run build` point at the LIVE backend.
# This URL is public (already shipped in the web app), not a secret.
#
# Local emulator/LAN testing still overrides this via the gitignored `.env`
# during `npm run dev` (development mode ignores .env.production).
# ============================================================================
VITE_API_URL=https://qelcarereactweb2-production.up.railway.app
REACT_APP_API_URL=https://qelcarereactweb2-production.up.railway.app
